# Desenvolvimento local: apenas /api/v1/chat/demo dispensa login.
ENVIRONMENT=development
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
# Produção: ENVIRONMENT=production; configure HTTPS no serviço de hospedagem.
# Não são necessárias chaves secret/service_role para validar o usuário.
# A chave Groq é privada: somente no servidor, nunca no APK ou Git.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_COMPLETION_TOKENS=1536
# Poe pago: chave privada somente no servidor. Não há fallback para Groq.
AI_PROVIDER=groq
POE_API_KEY=
POE_MODEL=GPT-OSS-120B
POE_VISION_MODEL=GPT-4.1-mini
POE_WEB_MODEL=GPT-4.1-mini
POE_MAX_OUTPUT_TOKENS=1536
